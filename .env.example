# Supabase proje ayarları (Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SADECE sunucu tarafında kullanılır (storage upload, admin işlemleri).
# ASLA client'a expose etmeyin / NEXT_PUBLIC_ prefix'i eklemeyin.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL — sitemap.xml, robots.txt ve Open Graph metadata için.
NEXT_PUBLIC_SITE_URL=https://pvpgundem.com
